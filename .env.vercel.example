APP_NAME="Laravel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Configure a managed/external database in Vercel Project Settings.
# Do not use SQLite or a local MySQL server for production on Vercel.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Serverless-friendly defaults; use a persistent external store if needed.
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Add your mail provider settings here as Vercel environment variables.
MAIL_MAILER=log
